```gitignore
# Dependencies
node_modules/
.pnpm-store/
.yarn/
.yarn-cache/

# Build outputs
dist/
build/
.next/
out/
.nuxt/
public/dist/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.venv/
.ENV
.python-version

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment variables
.env
.env.local
.env.*
!.env.example

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Testing
coverage/
.nyc_output/
istanbul/
.mocha/
.jest/

# Cache
.cache/
.turbo/
.vercel/
.netlify/

# Database
*.db
*.db-journal

# Temporary files
*.tmp
*.temp
.DS_Store
```